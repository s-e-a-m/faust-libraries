declare name "SEAM Filters - Library";
declare version "0.1";
declare author "Giuseppe Silvi";
declare author "Luca Spanedda";
declare author "Davide Tedesco";
declare license "CC3";
//
import("seam.lib");
//================================================================== FILTERS ===
//==============================================================================
sfi = library("seam.filters.lib");
// https://www.dsprelated.com/showarticle/182.php
// > eavga is a two-multiply exponential averager
// > eavgb is a one-multiply exponential averager
// The “app” subscript in Eq. (1) stands for approximation
aapp(fc) = 1-pow(ma.E, 0-sma.omega(fc));
// process = aapp(24000);
// acor not works below 4Hz at 96KHz
acor(fc) = cos(sma.omega(fc))-1+sqrt(sma.cosq(sma.omega(fc))-4*cos(sma.omega(fc))+3);
// process = acor(24000);
//----------------------------------------------------- EXPONENTIAL AVERAGER ---
//------------------------------------------------------------- TWO MULTIPLY ---
eavg2(a,x) = x*(a) : +~*(1-a);
// process = os.impulse : eavg2(0.5);
// process = os.impulse : eavg2(aapp(6000));
//------------------------------------------------------------- ONE MULTIPLY ---
eavg1(a,x) = (x+_ : *(a) : +~_)~(0-_);
// process = os.impulse : eavg1(0.5);
// process = os.impulse <: eavg(0.5), eavg1(0.5);
//------------------------------------------------- LOW PASS ONE POLE FILTER ---
lp1p(hz,x) = eavg1(aapp(hz),x);
// process = no.pink_noise : lp1p(7);
lp1pc(hz,x) = eavg1(acor(hz),x);
// process = no.noise <: lp1p(10), lp1pc(10);
//--------------------------------------------------------- HIGH PASS FILTER ---
hp1a(fc,x) = x-(lp1p(fc,x));
// process = no.pink_noise : hp1a(10000);
//----------------------------------------------------- TWO MULTIPLY ALLPASS ---
apf2(md,t,g) = (+ <: de.delay(md,t-1),*(-g))~ *(g) : mem,_ : +;
// process = os.impulse : cmtap(1,1/sqrt(2));
//
//-------------------------------------------------------- DC BLOCKER AT 5Hz ---
dcblock(x) = x <: (x-seq(i,4,lp1p(5)));
//process = 1 : dcblock;
//
//------------------------------------------ ALL-PASS FILTER COEF CALCULATOR ---
//
// REFERENCES:
// https://www.dsprelated.com/showcode/182.php
//
// 1st order allpass fstretchingilters shift the phase by 180 degrees, while
// the 2nd order shifts the phase by 360 degrees. The "center frequency" of
// Fc defines where the phase response should be halfway to the max shift.
//
// Bilinear transform
// g(fc) = tan(ma.PI*(fc/ma.SR));
//
ap2coeff(fc,q) = g(fc), b0(fc,q), b1(fc,q), b2, a1(fc,q), a2(fc,q)
with{
  g(fc) = sma.prewarp(fc);
  d(q)  = 1/q;
  k(fc,q)  = 1/(1 + (d(q)*g(fc)) + (g(fc)*g(fc)));
  b0(fc,q) = (1 - (g(fc)*d(q)) + (g(fc)*g(fc))) * k(fc,q);
  b1(fc,q) = 2 * ((g(fc)*g(fc)) - 1) * k(fc,q);
  b2 = 1;
  a1 = b1;
  a2 = b0;
};
// process = ap2coeff(24000,1);
ap1coeff(fc,q) = g(fc), b0(fc), b1, b2, a1(fc), a2
with{
 g(fc) = sma.prewarp(fc);
 b0(fc) = (g(fc)-1)/(g(fc)+1);
 b1 = 1;
 b2 = 0;
 a1 = b0;
 a2 = 0;
};
// process = ap1coeff(24000,1);
//
//------------------------------------------------ QUADRATURE / HILBERT PAIR ---
// Wideband 90-degree quadrature (Hilbert) transformer: mono -> (in-phase, quad).
// Both outputs are all-pass filtered; their phase difference holds -90 deg over
// 20 Hz-20 kHz. Neither output is the dry signal: the quadrature relation is a
// property of the matched pair. Realised in seam-ltm by the hilbert plugin,
// whose live design engine re-derives the coefficients per sample rate; the
// coefficients below are the fs = 48 kHz design.
//
// (1) RBJ form: matched pair of 2nd-order all-pass biquads, 3 sections per
//     branch, parameterised by (frequency, Q). Max phase error 1.36 deg @48k.
aprbj(f,Q) = fi.tf2(a2, a1, 1.0, a1, a2)
  with {
    w     = 2.0*ma.PI*f/ma.SR;
    alpha = sin(w)/(2.0*Q);
    n     = 1.0 + alpha;
    a1    = -2.0*cos(w)/n;
    a2    = (1.0 - alpha)/n;
  };
hRhil = aprbj(141.887012,0.201947) : aprbj(671.745773,0.212154) : aprbj(18654.238494,0.303097);
hIhil = aprbj(24.003923,0.309038)  : aprbj(2991.937233,0.384766) : aprbj(3219.986192,0.096342);
hilbertRBJ = _ <: hRhil, hIhil;
// process = os.osc(1000) : hilbertRBJ;
//
// (2) Polyphase form: matched pair of 1st-order all-pass sections (Niemitalo),
//     4 sections per path, with a one-sample relative delay on the quad path.
//     One multiply per section; max phase error 1.67 deg @48k.
appoly(a) = fi.tf2(a*a, 0.0, -1.0, 0.0, 0.0 - a*a);
hAhil = appoly(0.397260394) : appoly(0.853250636) : appoly(0.971682572) : appoly(0.995211876);
hBhil = appoly(0.687396697) : appoly(0.934674128) : appoly(0.987987539) : appoly(0.998735492);
hilbertPoly = _ <: hAhil, (hBhil : mem);
// process = os.osc(1000) : hilbertPoly;
//
//----------------- Vadim Zavalishin's TOPOLOGY PRESERVING TRANSFORM FILTERS ---
// TPT version of the One Pole and SVF Filter by Vadim Zavalishin
// reference : (by Will Pirkle)
// http://www.willpirkle.com/Downloads/AN-4VirtualAnalogFilters.2.0.pdf
// OnePoleTPT filter function
onePoleTPT(cf, x) = loop ~ _ : ! , si.bus(3)
    with {
        g = tan(cf * ma.PI * (1/ma.SR));
        G = g / (1.0 + g);
        loop(s) = u , lp , hp , ap
            with {
                v = (x - s) * G;
                u = v + lp;
                lp = v + s;
                hp = x - lp;
                ap = lp - hp;
            };
    };
// process = no.pink_noise : onePoleTPT(1000);
LPTPT(cf, x) = onePoleTPT(cf, x) : (_ , ! , !);
// process = no.pink_noise : LPTPT(1000);
HPTPT(cf, x) = onePoleTPT(cf, x) : (! , _ , !);
//process = no.pink_noise : HPTPT(1000);

// SVFTPT filter function
SVFTPT(K, Q, CF, x) = circuitout : !,!,_,_,_,_,_,_,_,_
    with{
        g = tan(CF * ma.PI / ma.SR);
        R = 1.0 / (2.0 * Q);
        G1 = 1.0 / (1.0 + 2.0 * R * g + g * g);
        G2 = 2.0 * R + g;

        circuit(s1, s2) = u1 , u2 , lp , hp , bp, notch, apf, ubp, peak, bshelf
            with{
                hp = (x - s1 * G2 - s2) * G1;
                v1 = hp * g;
                bp = s1 + v1;
                v2 = bp * g;
                lp = s2 + v2;
                u1 = v1 + bp;
                u2 = v2 + lp;
                notch = x - ((2*R)*bp);
                apf = x - ((4*R)*bp);
                ubp = ((2*R)*bp);
                peak = lp -hp;
                bshelf = x + (((2*K)*R)*bp);
            };
    // choose the output from the SVF Filter (ex. bshelf)
    circuitout = circuit ~ si.bus(2);
    };

// Outs = (lp , hp , bp, notch, apf, ubp, peak, bshelf)
// SVFTPT(K, Q, CF, x) = (Filter-K, Filter-Q, Frequency Cut)

// outs Filters Bank
LPTPTsvf(K, Q, CF, x) = SVFTPT(K, Q, CF, x) : _,!,!,!,!,!,!,!;
HPTPTsvf(K, Q, CF, x) = SVFTPT(K, Q, CF, x) : !,_,!,!,!,!,!,!;
// with bandwidth
BPTPTsvf(K, BW, CF, x) = SVFTPT(K, Q, CF, x*(BW/CF)) : !,!,_,!,!,!,!,!
    with{
        Q = CF / BW;
        };
// TEST
//import("stdfaust.lib");
//process = no.noise : BPTPTsvf(0, 1, 10000);
//
// Savitzky-Golay filter
// https://en.wikipedia.org/wiki/Savitzky-Golay_filter
// https://www.dsprelated.com/blogimages/JosefHoffmann/sav_golay_Filter.pdf
/*
A Savitzky–Golay filter is a digital filter that can be applied to a set of digital data points for the purpose of smoothing the data, that is, to increase the precision of the data without distorting the signal tendency. This is achieved, in a process known as convolution, by fitting successive sub-sets of adjacent data points with a low-degree polynomial by the method of linear least squares. When the data points are equally spaced, an analytical solution to the least-squares equations can be found, in the form of a single set of "convolution coefficients" that can be applied to all data sub-sets, to give estimates of the smoothed signal, (or derivatives of the smoothed signal) at the central point of each sub-set.
*/
// Coefficients for smoothing
// Polynomial Degree
// quadratic or cubic 2 or 3
sgsc5 = (-3/35, 12/35, 17/35, 12/35, -3/35);
sgsc7 = (-2/21, 3/21, 6/21, 7/21, 6/21, 3/21, -2/21);
sgsc9 = (-21/231, 14/231, 39/231, 54/231, 59/231, 54/231, 39/231, 14/231, -21/231);
// Coefficients for 1st derivative
// Polynomial Degree
// linear or quadratic 1 or 2
sgfdc3 = (-1/2,0/2,1/2);
sgfdc5 = (-2/10,-1/10,0/10,1/10,2/10);
sgfdc7 = (-3/28,-2/28,-1/28,0/28,1/28,2/28,3/28);
sgfdc9 = (-4/60,-3/60,-2/60,-1/60,0/60,1/60,2/60,3/60,4/60);
//
rw = no.pink_noise : si.smooth(.9) : *(10);
process = os.osc(300)/(2)+rw <: _, fi.conv(sgsc9),  fi.conv(sgfdc9);
//
//========================================================= AIR ABSORPTION ===
// Atmospheric absorption over distance (ISO 9613-1:1993). alpha(f,T,h) is the
// absorption coefficient in dB/m; the plugin renders A(f)=alpha*d as a
// minimum-phase filter. Magnitude = physics (ISO 9613-1), phase = the minimum
// phase that physics implies. Hand-ported to C++ in seam-ltm's
// plugins/_common/seam_airabsorption.h. Refs: ISO 9613-1; Bass, Sutherland,
// Zuckerwar, "Atmospheric absorption of sound".
//
// alpha(f, T[degC], h_rel[%]) in dB/m, at 1 atm.
airalpha(f, tC, rh) = 8.686 * f*f * (classical + relax)
with {
    pr  = 101.325;           pa  = 101.325;         // kPa, 1 atm
    T   = tC + 273.15;       T0  = 293.15;  T01 = 273.16;   // K
    pRatio = pa/pr;          tRatio = T/T0;
    psatRatio = pow(10.0, -6.8346*pow(T01/T, 1.261) + 4.6151);
    h   = rh * psatRatio / pRatio;                  // water-vapour molar conc. %
    frO = pRatio*(24.0 + 4.04e4*h*(0.02+h)/(0.391+h));
    frN = pRatio*pow(tRatio,-0.5)*(9.0 + 280.0*h*exp(-4.170*(pow(tRatio,-1.0/3.0)-1.0)));
    classical = 1.84e-11*(1.0/pRatio)*sqrt(tRatio);
    oxygen = 0.01275*exp(-2239.1/T)/(frO + f*f/frO);
    nitro  = 0.1068 *exp(-3352.0/T)/(frN + f*f/frN);
    relax  = pow(tRatio, -2.5)*(oxygen + nitro);
};
// process = airalpha(1000.0, 20.0, 50.0);   // ~0.005 dB/m at 1 kHz

// Second-order RBJ high-shelf (S=1): 0 dB at DC, gdb at Nyquist. The cascade
// topology stacks three of these; their gains are fitted to alpha*d by the C++
// engine per (distance,T,RH). Coefficients normalised (a0 = 1) for fi.tf2.
sfihishelf2(fc, gdb) = fi.tf2(b0, b1, b2, a1, a2)
with {
    A = pow(10.0, gdb/40.0);
    w0 = 2.0*ma.PI*fc/ma.SR;   cw = cos(w0);  sw = sin(w0);
    al = sw/2.0*sqrt(2.0);     sq = sqrt(A);
    a0 =    (A+1) - (A-1)*cw + 2*sq*al;
    b0 =  A*((A+1) + (A-1)*cw + 2*sq*al)/a0;
    b1 = -2*A*((A-1) + (A+1)*cw)/a0;
    b2 =  A*((A+1) + (A-1)*cw - 2*sq*al)/a0;
    a1 =  2*((A-1) - (A+1)*cw)/a0;
    a2 =    ((A+1) - (A-1)*cw - 2*sq*al)/a0;
};

// First-order high-shelf (prewarped bilinear): the deliberately-loose "gross
// tilt" Shelf topology. 0 dB at DC, gdb at HF, one section.
sfihishelf1(fc, gdb) = fi.tf1(b0, b1, a1)
with {
    V0 = pow(10.0, gdb/20.0);
    w0 = 2.0*ma.PI*fc;                  // analog rad/s
    c  = w0/tan(w0/(2.0*ma.SR));        // prewarp
    a0 = c + w0;
    b0 = (V0*c + w0)/a0;
    b1 = (w0 - V0*c)/a0;
    a1 = (w0 - c)/a0;
};

// Representative baked designs (like hilbert's 48 kHz coefficients): the gains
// below are the least-squares fit at d=20 m, T=20 degC, RH=50 %. The C++ engine
// (seam_airabsorption.h) re-fits these gains whenever distance, temperature or
// humidity change; the fixed corners {3,8,16} kHz (cascade) and 5 kHz (shelf)
// are the design's structural choice.
airCascade = sfihishelf2(3000.0, -0.5) : sfihishelf2(8000.0, -3.4) : sfihishelf2(16000.0, -6.8);
airShelf   = sfihishelf1(5000.0, -6.5);
// process = os.impulse : airCascade;
// process = os.impulse : airShelf;

//------------------------------------------ MATCHED-Z SPECTRAL TILT ---
// A constant-slope tilt of alpha nepers/neper built as a cascade of real
// first-order pole-zero pairs spaced geometrically from f0 to f1, mapped with
// the MATCHED-Z transform: z_pole = exp(-2*PI*f*T).
//
// Matched-Z and not bilinear, and the difference is measurable: the bilinear
// transform warps the frequency axis, so at 16 kHz with SR = 48 kHz the
// response is evaluated 0.73 octaves too high and reads -2.19 dB low. This is
// why fi.spectral_tilt cannot be used for a calibration reference; measured,
// it misses SMPTE ST 2095-1's +/-0.25 dB by 1.5 to 2.1 dB at every rate.
// See seam-ltm: plugins/multipink/source/multipink_pink.h,
// tests/multipink_pink_test.cpp, and
// docs/superpowers/specs/2026-08-19-pink-filter-mz-design.md
spectral_tilt_mz(N,f0,f1,alpha) = seq(i,N,sec(i))
with {
    r      = (f1/f0)^(1.0/float(N-1));
    mp(i)  = 2*ma.PI*f0*r^i;                       // analog pole, rad/s
    mz(i)  = 2*ma.PI*f0*r^(-alpha+i);              // analog zero, rad/s
    zp(i)  = exp(-mp(i)/ma.SR);
    zz(i)  = exp(-mz(i)/ma.SR);
    g(i)   = (1.0-zp(i))/(1.0-zz(i));              // unity gain at DC
    sec(i) = fi.tf1(g(i), -g(i)*zz(i), -zp(i));
};
// process = spectral_tilt_mz(17, 2.0, ma.SR/2, -0.5);

//------------------------------------------------ PINKING FILTER ---
// A matched-Z ladder at alpha = -1/2, plus one correction section that
// cancels the aliased tail matched-Z leaves behind. It does not call
// spectral_tilt_mz above: the ladder is reimplemented inline here because
// the correction section has to sit inside the same seq as the ladder
// sections, sharing their fixed maximum depth and their runtime
// ladder/correction/identity dispatch (see below), which a separate call to
// spectral_tilt_mz followed by corr could not express. That residual is a
// function of f/SR ALONE -- verified identical at 48 and 192 kHz to three
// decimal places -- so its correction has CONSTANT coefficients and must
// not be redesigned per rate.
// Fitted 2026-08-19; it takes the residual from 1.48 dB to 0.029 dB.
//
// Faust's seq/par repeat counts are resolved at compile time, but the ladder
// depth here is a function of the runtime sample rate (ma.SR), exactly like
// PinkDesign::design(fs) on the C++ side. The cascade is therefore built to a
// fixed maximum depth (NMAX, mirroring PinkDesign::kMaxSections) and every
// section past the sample rate's actual requirement is switched to the
// identity pair (b0=1, b1=0, a1=0) -- an exact no-op in IEEE 754, not an
// approximation. This is a runtime BYPASS, not a runtime SKIP: all NMAX
// sections are evaluated at every sample regardless of the sample rate, and
// the unused ones merely compute the identity rather than being omitted from
// the loop -- inside sno.multipink(4,0.5) that is 4*32 = 128 first-order
// sections evaluated per sample, not 4*(nladder+1). Structurally this is a
// fixed array with that runtime bypass, where the C++ is a variable-length
// loop that never touches unused array slots at all; numerically the two are
// the same filter, which is what the A/B in tools/faust-pink-ab.sh checks to
// 1e-12.
pink_filter_mz = seq(i,NMAX,sec(i))
with {
    NMAX    = 32;                                      // = PinkDesign::kMaxSections
    f0      = 2.0;
    f1      = ma.SR/2;
    w0      = 2*ma.PI*f0;
    nraw    = int(ceil(ma.log2(f1/f0))) + 1;            // one pole per octave
    nladder = max(2, min(nraw, NMAX-1));                // one slot reserved for the correction
    r       = (f1/f0)^(1.0/float(nladder-1));
    czero   = -0.250775213;
    cpole   = -0.160124183;
    cg      = (1.0-cpole)/(1.0-czero);

    mp(i) = w0*r^i;                                     // analog pole, rad/s
    mz(i) = w0*r^(0.5+i);                                // analog zero, rad/s
    zp(i) = exp(-mp(i)/ma.SR);
    zz(i) = exp(-mz(i)/ma.SR);
    gl(i) = (1.0-zp(i))/(1.0-zz(i));                     // unity gain at DC

    isLadder(i) = i < nladder;
    isCorr(i)   = i == nladder;

    b0(i) = ba.if(isLadder(i), gl(i),        ba.if(isCorr(i), cg,          1.0));
    b1(i) = ba.if(isLadder(i), 0-gl(i)*zz(i), ba.if(isCorr(i), 0-cg*czero, 0.0));
    a1(i) = ba.if(isLadder(i), 0-zp(i),       ba.if(isCorr(i), 0-cpole,    0.0));

    sec(i) = fi.tf1(b0(i), b1(i), a1(i));
};
// process = no.noise : pink_filter_mz;
