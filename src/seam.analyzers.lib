declare name "SEAM Analyzers - Library";
declare version "0.2";
declare author "Giuseppe Silvi";
declare license "CC3";
//
import("seam.lib");
//================================================================ ANALYZERS ===
//==============================================================================
san = library("seam.analyzers.lib");
//--------------------------------------------------------------- PEAK METERS --
pvmeter(x) = attach(x,
  an.amp_follower(0.150, x) : ba.linear2db :
  vbargraph("[90][unit:dB]", -70, +6)
  );
// process = os.osc(1000)*ba.db2linear(-7) : pvmeter;
//
phmeter(x) = attach(x,
  an.amp_follower(0.150, x) : ba.linear2db :
  hbargraph("[90][unit:dB]", -70, +6)
  );
// process = os.osc(1000)*ba.db2linear(-7) : phmeter;
//
//---------------------------------------------------- SOUND LEVEL WEIGHTING ---
//--------------------------------------------------- ANSI S1.43-1997 - 2007 ---
//---------------------------------------------- AMERICAN NATIONAL STANDARDS ---
//--------------------- SPECIFICATIONS FOR INTEGRATING-AVERAGING SOUND LEVEL ---
// https://en.wikipedia.org/wiki/A-weighting
// https://github.com/s-e-a-m/References/blob/master/aavv/ansi.s1.43.1997.pdf
//
//-------------------------------------------------------------- FREQUENCIES ---
awf1 = 20.598997;
awf2 = 107.65265;
awf3 = 737.86223;
awf4 = 12194.22;
awf5 = 158.48932;
//-------------------------------------- SCALE FACTORS TO HAVE 0dB at 1000Hz ---
C1000 = 0.0619;
B1000 = 0.1696;
A1000 = 1.9997;
//--------------------------------------------------------- A WEIGHTING OF f ---
aweight(f) = 20*log10(
  (awf4^2*f^4) /
  ((f^2+awf1^2) * sqrt((f^2+awf2^2) * (f^2+awf3^2)) * (f^2+awf4^2))
  ) +(A1000);
//process = aweight(100);
//--------------------------------------------------------- B WEIGHTING OF f ---
bweight(f) = 20*log10(
             (awf4^2*f^3) /
             ((f^2+awf1^2) * (f^2+awf4^2) * sqrt((f^2+awf5^2)))
             ) +(B1000);
//process = bweight(100);
//--------------------------------------------------------- C WEIGHTING OF f ---
cweight(f) = 20*log10(
             (awf4^2*f^2) /
             ((f^2+awf1^2) * (f^2+awf4^2))
             ) +(C1000);
//process = cweight(1000);
//--------------------------------------------------------- PITCH TRACKER ---
// From faust documentation
upt(a,x) = a*ma.SR / max(M,1) - a * ma.SR * (M == 0)
with{
  // positive zero crossing
  xcr = (x' < 0) & (x >= 0);
  // counts of crossing
  xcnt = +(xcr)~ %(int(a));
  // windows of counts
  wnd = xcr & (xcnt == a);
  // counting samples inside windows
  N = (+(1) : *(1 - wnd)) ~ _;
  // sample and hold the number of cycles
  M = ba.sAndH(N == 0, N' + 1);
};
//a = hslider("n cycles", 1, 1, 100, 1);
ptrack(a,x) = x : fi.dcblockerat(80) : (fi.lowpass(1) : upt(a)) ~ max(100);
//process = os.osc(1000) : ptrack(10);
//---------------------------------------------------- STEREO FIELD ANALYZERS --
// Numeric-only stereo-field descriptors (no GUI). Moving means via one-pole
// smoothing over a fixed window. Ported by hand into seam-ltm strx_dsp.h.
sfa_tau = 0.3; // moving-average window (s)
sfa_avg(x) = x : si.smooth(ba.tau2pole(sfa_tau));
sfa_eps = 1e-12;
//
// Normalized L/R cross-correlation in [-1,1]: mean(l*r)/sqrt(mean(l^2)*mean(r^2)).
correlation(l, r) = sfa_avg(l*r) / sqrt(max(sfa_eps, sfa_avg(l*l) * sfa_avg(r*r)));
// process = os.osc(1000) <: _, _ : correlation;   // correlated -> ~1
//
// Side/Mid RMS ratio in [0,1] (0 = mono). M=(l+r)/sqrt(2), S=(l-r)/sqrt(2).
width(l, r) = rmsS / max(sfa_eps, rmsM + rmsS) with {
  m = (l + r) / sqrt(2);
  s = (l - r) / sqrt(2);
  rmsM = sqrt(sfa_avg(m*m));
  rmsS = sqrt(sfa_avg(s*s));
};
// process = os.osc(1000), os.osc(1000)*(-1) : width;   // anti-phase -> ~1
//
// L/R energy balance in [-1,1] (0 = centered, +1 = hard right).
panorama(l, r) = (er - el) / max(sfa_eps, er + el) with {
  el = sfa_avg(l*l);
  er = sfa_avg(r*r);
};
// process = os.osc(1000), 0 : panorama;   // left only -> ~ -1
//
// Principal-axis angle of the L/R covariance (radians); ~pi/4 for in-phase/mono content, 0 when only one channel carries energy.
vectorangle(l, r) = 0.5 * atan2(2*sfa_avg(l*r), sfa_avg(l*l) - sfa_avg(r*r));
// process = os.osc(1000) <: _, _ : vectorangle;   // correlated -> ~pi/4
//
//------------------------------------- ISO 266 THIRD-OCTAVE BAND ANALYZER ---
// Band levels on the ISO 266 base-ten grid, each averaged over a time matched
// to its own bandwidth, and the pink-reference deviation that turns a
// pink-noise measurement into a loudspeaker equalisation.
// Written as the spec for seam-ltm strx (STONE calibration read from an
// AB microphone pair); ported by hand into strx_bands.h.
//
// Relation to the standard library: an.mth_octave_spectral_level6e(M,ftop,N,
// tau,dB_offset) solves the neighbouring problem and differs in three ways
// that matter once the measurement is read against a pink reference:
//   1. its band grid is a geometric series anchored at ftop, not the ISO 266
//      preferred numbers an EQ and an acoustician name their bands by;
//   2. it averages every band with one global tau;
//   3. it attaches bargraphs, so the levels are a display and not a value.
// This section keeps its filterbank (fi.bandpass6e, the same elliptic section
// an.mth_octave_analyzer6e uses) and changes those three things.
//
// NUMERICAL NOTE -- this filterbank REQUIRES double precision. Verified by
// running it, not by reading it: compiled with the default single precision,
// every band at or below 160 Hz collapses onto the ma.EPSILON floor, because a
// 6th-order elliptic bandpass 4.6 Hz wide at 20 Hz is hopelessly ill
// conditioned in direct form at 32 bits. Compiled with -double the same bank
// reads pink noise flat to +/-0.7 dB, which is the +/-0.6 dB that BT = 50
// predicts. Any port keeps its band state in double for the same reason.
//
// WHAT THE NUMBERS MEAN -- each value is a BAND-INTEGRATED deviation taken
// against the mean of the range, so it is the gain for a band filter and not
// the depth of a narrow notch. A 6 dB dip one third of an octave wide reads
// about 3.5 dB, and a defect broad enough to move the mean partly hides inside
// its own reference. Both make the table under-report rather than over-report,
// which is the safe direction to converge from when the correction is applied
// and the measurement repeated.
//
//--------------------------------------------------------------- THE GRID ---
// Exact ISO 266 midband frequency of third-octave band n, n = 0 at 1 kHz.
// The base-ten grid (10^(n/10)) is the one ISO 266 prefers; a base-two grid
// (2^(n/3)) drifts from it by 0.08% per band.
tob_fc(n) = 1000.0 * (10.0 ^ (float(n)/10.0));
tob_fl(n) = tob_fc(n) * (10.0 ^ (-0.05));
// The upper edge is clamped just under Nyquist so the band count stays fixed
// across sample rates: at 44.1 kHz the 20 kHz band would otherwise ask
// fi.bandpass6e for a 22.4 kHz corner it cannot design. The top band narrows
// instead of the filterbank falling apart.
tob_fu(n) = min(tob_fc(n) * (10.0 ^ (0.05)), 0.49 * ma.SR);
tob_bw(n) = tob_fu(n) - tob_fl(n);
// process = tob_fc(0);   // -> 1000; tob_fc(-17) -> 19.95, tob_fc(13) -> 19952
//
//------------------------------------------------ PER-BAND AVERAGING TIME ---
// The confidence of a noise level estimate depends on the bandwidth-time
// product BT, so one global tau leaves the low bands rattling while the high
// ones lag. tau = BT/B equalises the confidence across the filterbank:
// ~11 s at 20 Hz, ~0.22 s at 1 kHz. BT = 50 is about +/-0.6 dB. Clamped so no
// band waits longer than 20 s or reacts faster than 0.1 s (above that the top
// bands only flicker, with no statistical gain).
tob_bt = 50.0;
tob_tau(n) = max(0.1, min(20.0, tob_bt / tob_bw(n)));
// process = tob_tau(0);   // -> 0.2167 s
//
tob_ms(n) = _ <: * : si.smooth(ba.tau2pole(tob_tau(n)));   // mean square
tob_db    = max(ma.EPSILON) : log10 : *(10.0);             // power -> dB
//
//------------------------------------------------------------ BAND LEVELS ---
// N band levels in dB, starting at band index n0.
thirdoctave_levels(n0, N) = _ <: par(i, N,
  fi.bandpass6e(tob_fl(n0+i), tob_fu(n0+i)) : tob_ms(n0+i) : tob_db);
// process = no.pink_noise : thirdoctave_levels(-17, 31);  // 31 equal levels
//
// Same for a spaced microphone pair: the two capsules are averaged in POWER,
// band by band, and never summed to Mid. Two spaced omnis decorrelate above
// c/2d (430 Hz at 40 cm spacing), so a Mid sum combs by geometry right where
// the measurement is being read.
thirdoctave_levels_ab(n0, N) = par(c, 2, bands) :> par(i, N, _/2.0 : tob_db)
with {
  bands = _ <: par(i, N, fi.bandpass6e(tob_fl(n0+i), tob_fu(n0+i)) : tob_ms(n0+i));
};
// process = no.pink_noise <: _,_ : thirdoctave_levels_ab(-17, 31);
//
//-------------------------------------------------- PINK-REFERENCE ERROR ---
// Deviation of N band levels from the mean of the ni bands starting at i0.
// Against pink noise this IS the error curve: pink carries equal energy in
// every constant-relative-bandwidth band, so a correct loudspeaker reads flat
// and the mean is the only reference the measurement needs. Absolute level,
// microphone sensitivity and distance all fall out with the mean -- and so
// does any smooth error of the microphone itself.
pinkdev(N, i0, ni) = si.bus(N) <: (si.bus(N), (mean <: si.bus(N)))
  : ro.interleave(N, 2) : par(i, N, -)
with {
  mean = par(i, N, _ * ((i >= i0) & (i < i0+ni))) :> _ / float(ni);
};
//
// The dB to DIAL IN on the amplifier, i.e. minus the deviation. It gets its
// own function because the sign is the one thing a comment cannot enforce.
pinkcomp(N, i0, ni) = pinkdev(N, i0, ni) : par(i, N, *(-1.0));
//
// The STONE calibration case: 31 bands from 20 Hz (n=-17) to 20 kHz (n=13),
// zeroed on 31.5 Hz .. 16 kHz (array indices 2..29), so the noisy extreme
// bands are shown but do not drag the reference.
stone_pinkcomp = thirdoctave_levels_ab(-17, 31) : pinkcomp(31, 2, 28);
// process = no.pink_noise <: _,_ : stone_pinkcomp;
